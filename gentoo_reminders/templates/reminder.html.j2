<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
body{font-family:sans-serif;max-width:680px;margin:0 auto;color:#222;line-height:1.4}
h2{border-bottom:1px solid #ddd;padding-bottom:3px;margin-top:1.5em;font-size:1.1em}
pre{background:#f6f6f6;padding:10px 14px;border-radius:3px;overflow-x:auto;font-size:.9em}
a{color:#0060a0}
ul{margin:4px 0 0;padding-left:1.4em}
li{margin-bottom:3px}
.meta{color:#555;font-size:.9em}
.footer{margin-top:2em;padding-top:8px;border-top:1px solid #eee;color:#888;font-size:.85em}
</style>
</head>
<body>
<p>Hi {{ maintainer.email }},</p>
<p>Here is your monthly Gentoo package maintenance summary.
You maintain <strong>{{ maintainer.packages | length }}</strong> package{{ "s" if maintainer.packages | length != 1 }}.</p>
{% if maintainer.last_authored or maintainer.last_committed %}
<p class="meta">
{% if maintainer.last_authored %}
Last commit authored: {{ maintainer.last_authored }}<br>
{% endif %}
{% if maintainer.last_committed %}
Last commit committed: {{ maintainer.last_committed }}
{% endif %}
</p>
{% endif %}
{% for section in sections %}
{% if section.text %}
<h2>{{ section.title }}</h2>
<pre>{{ section.text }}</pre>
{% else %}
<h2>{{ section.title }} ({{ section.items | length }})</h2>
<ul>
{% for item in section.items %}
<li>{% if item.url %}<a href="{{ item.url }}">{{ item.ref }}</a>{% else %}{{ item.ref }}{% endif %}{{ item.text }}</li>
{% endfor %}
</ul>
{% endif %}
{% endfor %}
<p class="footer">Generated by gentoo-reminders</p>
</body>
</html>
